          "legendFormat": "среди последних 1000",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(fraud_detector_flagged_total[1m])) / sum(rate(fraud_detector_transactions_total[1m]))",
          "legendFormat": "за минуту",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
