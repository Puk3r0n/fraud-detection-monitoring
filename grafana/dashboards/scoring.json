    {
      "type": "heatmap",
      "title": "Распределение скоров во времени",
      "description": "Гистограмма fraud_detector_score по 15-секундным интервалам",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(fraud_detector_score_bucket[15s])) by (le)",
          "legendFormat": "{{le}}",
          "range": true,
          "format": "heatmap",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "axisLabel": "score"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "scale": "exponential",
          "exponent": 0.5
        },
        "cellGap": 1,
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "rowsFrame": {
          "layout": "auto"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Неизвестные значения признаков",
      "description": "Доля транзакций, у которых мерчант, категория или штат не встречались в train модели. Для них признак берётся по умолчанию, рост доли - сигнал дрейфа входа",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (feature) (rate(fraud_detector_unknown_values_total[1m])) / scalar(sum(rate(fraud_detector_transactions_total[1m])))",
          "legendFormat": "{{feature}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "axisSoftMax": 0.05
          },
          "min": 0,
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
