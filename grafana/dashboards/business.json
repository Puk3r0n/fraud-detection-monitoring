    {
      "type": "timeseries",
      "title": "Сумма под подозрением фрода",
      "description": "Свой бизнес-график: сколько денег в минуту проходит через транзакции с fraud_flag = 1 на фоне всего оборота. Это объём, который придётся проверять вручную или блокировать",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\n            SELECT $__timeGroupAlias(scored_at, '1m'),\n                   coalesce(sum(amount) FILTER (WHERE fraud_flag = 1), 0) AS \"помечено фродом, $\",\n                   sum(amount) AS \"весь оборот, $\"\n            FROM scores WHERE $__timeFilter(scored_at) AND ('__all' IN ($state) OR us_state IN ($state)) AND ('__all' IN ($merch) OR merch IN ($merch))\n            GROUP BY 1 ORDER BY 1\n        ",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
