          "type": "grafana-postgresql-datasource",
          "uid": "postgres"
        },
        "query": "SELECT DISTINCT merch FROM scores WHERE merch IS NOT NULL AND ('__all' IN ($state) OR us_state IN ($state)) ORDER BY 1",
        "definition": "SELECT DISTINCT merch FROM scores WHERE merch IS NOT NULL AND ('__all' IN ($state) OR us_state IN ($state)) ORDER BY 1",
