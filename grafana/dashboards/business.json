    {
      "type": "barchart",
      "title": "Плотность распределения скоров",
      "description": "Гистограмма скоров с шагом 0.05, нормированная на плотность: площадь столбцов равна 1. Учитывает фильтры штата и мерчанта",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\n            WITH s AS (SELECT score FROM scores WHERE $__timeFilter(scored_at) AND ('__all' IN ($state) OR us_state IN ($state)) AND ('__all' IN ($merch) OR merch IN ($merch))),\n                 b AS (SELECT least(floor(score * 20), 19)::int AS bin, count(*) AS n FROM s GROUP BY 1)\n            SELECT to_char(g.bin / 20.0, 'FM0.00') || '-' || to_char((g.bin + 1) / 20.0, 'FM0.00') AS score,\n                   coalesce(b.n, 0) / greatest((SELECT count(*) FROM s), 1)::float * 20 AS density\n            FROM generate_series(0, 19) AS g(bin) LEFT JOIN b USING (bin)\n            ORDER BY g.bin\n        ",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "score",
        "orientation": "auto",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": -45
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "TPS отфильтрованных транзакций",
      "description": "Транзакции в секунду по 10-секундным интервалам",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\n            SELECT $__timeGroupAlias(scored_at, '10s'), count(*) / 10.0 AS \"tx/s\",\n                   count(*) FILTER (WHERE fraud_flag = 1) / 10.0 AS \"фрод tx/s\"\n            FROM scores WHERE $__timeFilter(scored_at) AND ('__all' IN ($state) OR us_state IN ($state)) AND ('__all' IN ($merch) OR merch IN ($merch))\n            GROUP BY 1 ORDER BY 1\n        ",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "id": 6
    },
    {
      "type": "barchart",
      "title": "Доля фрода по категориям, последние 1000 транзакций",
      "description": "Средний fraud_flag по cat_id среди последних 1000 транзакций с учётом фильтров",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\n            SELECT cat_id, avg(fraud_flag)::float AS fraud_share\n            FROM (SELECT cat_id, fraud_flag FROM scores WHERE ('__all' IN ($state) OR us_state IN ($state)) AND ('__all' IN ($merch) OR merch IN ($merch)) ORDER BY scored_at DESC LIMIT 1000) t\n            GROUP BY cat_id ORDER BY fraud_share DESC\n        ",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
